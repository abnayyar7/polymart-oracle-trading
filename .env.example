# ORACLE — Environment Variables Example
# Copy this file to .env and fill in your values.
# All values can also be set directly in config/config.json.

# ── Polymarket CLOB API ──────────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your free key: https://aistudio.google.com
GEMINI_API_KEY=

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Create bot via @BotFather, get api_id/api_hash at https://my.telegram.org/apps
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── CryptoPanic ───────────────────────────────────────────────────────────────
# Free token at https://cryptopanic.com/api/v1
CRYPTOPANIC_AUTH_TOKEN=

# ── Whale Alert (optional) ────────────────────────────────────────────────────
# Free tier at https://whale-alert.io
WHALE_ALERT_API_KEY=

# ── Ollama (local) ────────────────────────────────────────────────────────────
# Default: http://localhost:11434  (no key required)
# Model: qwen2.5:14b  — pull with: ollama pull qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434
